{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "left",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 14,
  "control-center-margin-left": 14,
  "notification-2fa-album-art": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 420,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Centrum oznámení",
      "clear-all-button": true,
      "button-text": "󰎟 Vymazat"
    },
    "dnd": {
      "text": "󰂛 Režim Nerušit"
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰤨 Wi-Fi",
          "type": "toggle",
          "command": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on",
          "update-command": "nmcli radio wifi | grep -q enabled && echo true || echo false"
        },
        {
          "label": "󰂯 BT",
          "type": "toggle",
          "command": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
          "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
        },
        {
          "label": "󱩌 Noc",
          "type": "toggle",
          "command": "pgrep gammastep > /dev/null && pkill gammastep || gammastep -O 3800 &",
          "update-command": "pgrep gammastep > /dev/null && echo true || echo false"
        },
        {
          "label": "󰄀 Výstřižek",
          "type": "normal",
          "command": "swaync-client -cp; hyprshot -m region"
        },
        {
          "label": "󰌾 Zamknout",
          "type": "normal",
          "command": "swaync-client -cp; hyprlock"
        },
        {
          "label": "󰐥 Vypnout",
          "type": "normal",
          "command": "swaync-client -cp; wlogout"
        }
      ]
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": false
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "subsystem": "backlight"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
